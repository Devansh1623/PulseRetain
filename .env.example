# PulseRetain — Environment Variables
# Copy this file to .env and fill in values for your environment.
# Never commit .env to version control.

# Logging
LOG_LEVEL=INFO

# Optional: override config file location
# PULSE_CONFIG_PATH=config/settings.yaml

# Optional: set TensorFlow verbosity (0=all, 1=no info, 2=no warnings, 3=errors only)
TF_CPP_MIN_LOG_LEVEL=2

# Optional: disable TF GPU (force CPU for reproducibility)
# CUDA_VISIBLE_DEVICES=""
